# Gravel Segments - SEO-friendly redirects and rewrites

# Enable mod_rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect root to French version (or language based on Accept-Language header)
  RewriteCond %{REQUEST_URI} ^/?$
  RewriteCond %{HTTP:Accept-Language} ^nl [NC]
  RewriteRule ^(.*)$ /nl/ [R=301,L]

  RewriteCond %{REQUEST_URI} ^/?$
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^(.*)$ /en/ [R=301,L]

  RewriteCond %{REQUEST_URI} ^/?$
  RewriteRule ^(.*)$ /fr/ [R=301,L]

  # Remove trailing slashes from language directories (optional)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Cache control for assets
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>

# Prevent directory listing
Options -Indexes

# Set correct MIME types
AddType application/javascript js
AddType application/json json
